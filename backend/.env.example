PORT=3001
CLIENT_ORIGINS=http://localhost:5173,https://bb-te.github.io

# Development persistence. The file adapter is useful locally but is not durable
# on ephemeral hosts. Production must replace it with the Supabase adapter.
PERSISTENCE_MODE=file
STYLEOS_STORAGE_PATH=storage/styleos-memory.json
# Never enable this on a public host. It exposes a device-id development API
# without real authentication and local files may be erased by the host.
ENABLE_UNAUTHENTICATED_MEMORY_SYNC=false

# Reserved for the production Supabase adapter. Keep service keys on the server.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Image recognition stays disabled until a server-side provider is configured.
# Never expose IMAGE_ANALYSIS_API_KEY through a VITE_* frontend variable.
IMAGE_ANALYSIS_ENABLED=false
IMAGE_ANALYSIS_PROVIDER=
IMAGE_ANALYSIS_ENDPOINT=
IMAGE_ANALYSIS_API_KEY=
