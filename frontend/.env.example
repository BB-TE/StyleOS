VITE_API_BASE_URL=http://localhost:3001
VITE_BASE_PATH=/
VITE_ROUTER_MODE=browser
VITE_LOCAL_DEMO_ONLY=false
# Both flags are opt-in. Memory still stays local until the user explicitly
# chooses text-memory sync in the onboarding privacy step.
VITE_MEMORY_SYNC_ENABLED=false
VITE_REMOTE_MEMORY_ANALYSIS_ENABLED=false
